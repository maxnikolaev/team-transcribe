# ============================================================
#  Team Transcribe — переменные окружения (шаблон)
#  Скопируй в `.env` и заполни своими значениями.
#  Файл `.env` НЕ коммитится (в .gitignore).
# ============================================================

# ===== Telegram =====
# Токен бота от @BotFather (t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# ===== Deepgram (транскрибация) =====
# Ключ: https://console.deepgram.com → API Keys
# При регистрации дают $200 бесплатных кредитов.
DEEPGRAM_API_KEY=
# Модель: nova-3 (лучшая) | nova-2 | base | enhanced
DEEPGRAM_MODEL=nova-3
# Язык по умолчанию: ru | en | multi | ... (пусто = автоопределение)
DEEPGRAM_LANGUAGE=ru
# Разбивка по говорящим («кто что сказал»)
DEEPGRAM_DIARIZE=true
# Автоформатирование: пунктуация, регистр, числа
DEEPGRAM_SMART_FORMAT=true

# ===== Git: куда бот сохраняет транскрипты =====
# Целевой репозиторий (источник правды по проектам).
GIT_REPO_URL=
# Локальная папка с клоном целевого репозитория.
GIT_REPO_DIR=
GIT_BRANCH=main
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# ===== Сохранение =====
# Имя подпапки внутри папки проекта, куда кладутся транскрипты (.md).
TRANSCRIPTS_SUBFOLDER=транскрибации

# ===== Уведомления =====
# Глобальный чат (chat_id) для уведомлений о новых транскриптах.
# Пусто = уведомлять только отправителя. Перекрывается per-project в projects.yaml.
NOTIFY_CHAT_ID=

# ===== Путь к конфигу проектов (опционально) =====
# CONFIG_PATH=config/projects.yaml
